NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (admin "Start from your lesson notes") ─────────────────
# Server-only. Read exclusively by app/api/admin/parse-notes/route.ts and
# never exposed to the browser — do NOT prefix it with NEXT_PUBLIC_.
# Get one at console.anthropic.com. Without it, /admin/week/new says so and
# the "start blank" path still works.
ANTHROPIC_API_KEY=

# ── /roster (ASM Roster, ported from histakjake/asm-roster) ──────────
# Same values as the original Cloudflare Worker's secrets, except email.
ADMIN_EMAIL=
GOOGLE_SCRIPT_URL=
GAS_SHARED_SECRET=
DRIVE_FOLDER_ID=
SITE_PASSWORD=
# MAILCHANNELS_FROM is gone — MailChannels only authenticates requests
# from Cloudflare's own network, so it can't be used from this host.
# Swapped for Resend (resend.com): get RESEND_API_KEY from their
# dashboard, and verify ROSTER_EMAIL_FROM's domain there before real
# mail will send. Until RESEND_API_KEY is set, emails just log instead
# of sending — everything else in /roster still works.
RESEND_API_KEY=
ROSTER_EMAIL_FROM=
# The public URL of this site. Password-reset and account-approval emails
# build their links from it. Without it the links are built from the incoming
# request, which behind a proxy is an internal hostname that resolves for
# nobody. Local: http://localhost:3000 — deployed: the real https:// URL.
NEXT_PUBLIC_SITE_URL=
